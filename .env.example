# --- App ---
LOG_LEVEL=INFO
CORS_ORIGINS=*
DEBUG=true

# --- Paths ---
MODEL_DIR=models
TAXONOMY_DIR=app/taxonomy
DATA_DIR=data

# --- Files ---
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf,.docx,.txt

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Baseline matching weights (should sum to 1.0) ---
MATCH_SKILL_WEIGHT=0.50
MATCH_EXPERIENCE_WEIGHT=0.20
MATCH_EDUCATION_WEIGHT=0.10
MATCH_LOCATION_WEIGHT=0.10
MATCH_PREFERENCE_WEIGHT=0.10

# --- Hybrid matching weights (should sum to 1.0) ---
HYBRID_SKILL_WEIGHT=0.50
HYBRID_SEMANTIC_WEIGHT=0.30
HYBRID_EXPERIENCE_WEIGHT=0.15
HYBRID_EDUCATION_WEIGHT=0.05

# --- Database ---
# Local dev (matches docker-compose.yml postgres service):
DATABASE_URL=postgresql+psycopg://careeriq:careeriq@localhost:5432/careeriq
# Use a separate disposable database for tests, e.g.:
# DATABASE_URL=postgresql+psycopg://careeriq:careeriq@localhost:5432/careeriq_test

# --- Auth / JWT ---
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Never commit a real secret -- this placeholder is deliberately insecure and
# the app refuses to start with it when DEBUG=false.
JWT_SECRET_KEY=insecure-dev-secret-key-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- AI Career Assistant / Gemini ---
# Get a free API key at https://aistudio.google.com/apikey (no credit card
# required for the Flash-tier free quota). Leave GEMINI_API_KEY empty to run
# without the AI assistant enabled -- every other CareerIQ feature (matching,
# skill gaps, learning recommendations, career plans) works fully without it.
# Never commit a real key.
GEMINI_API_KEY=
# Gemini's official OpenAI-compatible endpoint -- point this at a different
# OpenAI-compatible provider/proxy by changing only this URL, no code change needed.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.7-flash
# Granular timeouts -- the "read" timeout is the one that matters most under
# Gemini's documented transient "model overloaded" (503) behavior; connect/
# write to Google's endpoint are normally fast and don't need much headroom.
GEMINI_READ_TIMEOUT_SECONDS=30.0
GEMINI_CONNECT_TIMEOUT_SECONDS=5.0
GEMINI_WRITE_TIMEOUT_SECONDS=10.0
GEMINI_POOL_TIMEOUT_SECONDS=5.0
# Retries: Google's own guidance for a transient 503/429 is to retry with
# exponential backoff, no more than ~2 times (retries also count against
# free-tier quota, so keep this small).
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_DELAY_SECONDS=1.0
